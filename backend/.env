PROJECT_NAME="Rovia API"
ENVIRONMENT="local"

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=rovia
POSTGRES_PASSWORD=rovia_secret
POSTGRES_DB=rovia
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=rovia_local_secret_key_12345
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (MinIO local)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=rovia-assets

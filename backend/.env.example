PROJECT_NAME="Rovia API"
ENVIRONMENT="local"

# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=rovia
POSTGRES_PASSWORD=rovia_secret
POSTGRES_DB=rovia
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=generate_a_strong_secret_key_here_for_local_dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (MinIO local)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=rovia-assets
